###############################################################################
# DJ Nounoune configuration
#
# Copy this file to `.env` at the repository root and fill it in. Every key below is read
# through NestJS ConfigService, so a value left empty is the same as a missing one.
#
# Only the CORE section is required to boot. Each service section is needed only when that
# service is used; a missing key is logged at startup and the feature stays off rather than
# crashing the app. The README documents the setup steps for each service.
#
# Never commit `.env`. It is gitignored and excluded from the Docker image by `.dockerignore`.
###############################################################################


###############################################################################
# CORE
###############################################################################

# MongoDB connection string. Everything is stored here: artists, albums, songs, chat history,
# sessions, the play log and the negentropy ledger. Put credentials and options in the URI
# itself, e.g. mongodb://user:pass@host:27017/?authSource=admin&tls=true
# A replica set is not required. Required to boot.
MONGODB_URI=

# Database name the collections live in. Required to boot.
MONGO_DATABASE=

# Not read by the app. Kept for tooling that composes the URI above from parts; the app only
# uses the credentials embedded in MONGODB_URI.
MONGO_USER=
MONGO_PASSWORD=

# Google Gemini API key from https://aistudio.google.com/. Drives every agent: the chat, the disc
# jockey, the database query generator, enrichment, album cover lookup and artist commentary.
# The models are pinned in code (gemini-3-flash-preview / gemini-3-pro-preview). Required to boot.
GENAI_API_KEY=

# Shared secret every client must present as the `x-api-key` header on REST calls and on the
# Socket.io handshake. This is the only authentication there is: pick a long random string.
AUTHX_API_KEY=

# HTTP + WebSocket port. Defaults to 3000. The OAuth callback URLs below must match it.
PORT=

# Log verbosity: error | warn | info (default) | debug | verbose
# `debug` shows the MPD protocol traffic and per-track import decisions; `verbose` adds the rest.
LOG_LEVEL=

# Source types the AI agents are allowed to search and play, comma separated.
# Values: file, spotify, applemusic, youtube, qobuz. Leave empty to allow every source.
# Drop a source here when its subscription lapses: the data stays in the database and the CLI,
# importers and de-duplication keep using every row, but the agents ignore it completely.
ACTIVE_SOURCE_TYPES=file,qobuz,spotify


###############################################################################
# MPD (Music Player Daemon)
###############################################################################

# Host and port of the MPD server the app plays through. The app is a plain TCP client of the MPD
# line protocol, so anything MPD-compatible (Mopidy included) works. Port defaults to 6600.
MPD_HOST=
MPD_PORT=


###############################################################################
# LOCAL FILE LIBRARY IMPORT  (npm run cli -- music import -f <file.psv>)
###############################################################################

# Local files enter the library from a pipe-separated export of your tag editor. The column layout
# is in files/import.template.psv. Each row's Path column is rewritten so MPD can find the file:
# the import root is stripped off the front and the MPD root is put in its place.

# Path convention used in the PSV: `Windows` (backslashes, drive letter) or `Linux` (default).
# With `Windows`, backslashes are converted to `/` before the root is stripped.
IMPORT_LIBRARY_PATH_STYLE=

# Root of the music library exactly as it appears in the PSV Path column, e.g. D:\Music\ or
# /mnt/music/. Keep the trailing separator, otherwise the first folder name keeps a leading slash.
IMPORT_LIBRARY_PATH_ROOT=

# The same library root as MPD sees it (its `music_directory`, or the share mounted there),
# e.g. /music/. Keep the trailing /. Also used by `music enrich --Ffprobe` to open the files.
LIBRARY_ROOT_PATH=


###############################################################################
# SPOTIFY  (npm run cli -- spotify auth | list | import)
###############################################################################

# Create an app at https://developer.spotify.com/dashboard and copy its credentials here.
# The app is in Development mode by default: ONLY the Spotify accounts listed under the app's
# "User Management" (25 at most) receive usable tokens. An account that is not listed gets
# `HTTP 403 The user is not registered for this application` on every call, even public ones,
# and re-authenticating does not help. Add the account you will sign in with before `spotify auth`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth callback, handled by GET /auth/spotify/callback on this server. Must be registered
# verbatim on the app's Redirect URIs. For a local server: http://127.0.0.1:3000/auth/spotify/callback
# (Spotify no longer accepts `localhost`; use the loopback IP.)
SPOTIFY_REDIRECT_URL=

# Base URL of the proxy that serves Spotify audio to MPD, e.g. http://localhost:8666
# The queued MPD uri becomes <proxy>/spotify?uri=spotify:track:<trackId>
# Needed only to PLAY spotify sources — which includes the negentropy pass, that swaps low-quality
# queued files for their Spotify stream and leaves Spotify out of its ladder when this is unset.
# Import and search work without it.
SPOTIFY_PROXY_AUDIO=

# Scopes requested by `spotify auth`: user-read-private, user-read-email, user-library-read,
# playlist-modify-public, playlist-modify-private. The session (access + refresh token) is written
# to .spotify-session.json at the repo root and refreshed automatically while the app runs.


###############################################################################
# QOBUZ  (npm run cli -- qobuz auth | favorites | favorite-albums | import-favorite-albums)
###############################################################################

# Qobuz has no public developer program. The credentials are the ones the Qobuz web player itself
# uses; a paying Qobuz account is required for streaming.

# Catalogue API credentials (search, track/album lookup, favourites, stream URLs).
# Found in the web player's JavaScript bundle: search it for the keywords `recette`,
# `appSecret` and `appId`. Without both, QobuzService logs a warning and every Qobuz feature is off.
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# OAuth login credentials, used by `qobuz auth` to trade the login for a user token.
# Captured from the web player's OAuth handshake: enable SSLKEYLOGFILE in your user environment so
# Wireshark can decrypt HTTPS, sign in on the web player, then look at the request to
# /api.json/0.2/oauth/callback?code=...&private_key=...  The app id and private key are there.
# Both fall back to the values the web player was using when this was written; set them when
# those stop working.
QOBUZ_OAUTH_APP_ID=
QOBUZ_OAUTH_PRIVATE_KEY=

# API and OAuth endpoints. Defaults: https://www.qobuz.com/api.json/0.2 and
# https://www.qobuz.com/signin/oauth. Leave empty unless Qobuz moves them.
QOBUZ_API_BASE=
QOBUZ_OAUTH_URL=

# OAuth callback, handled by GET /auth/qobuz/callback on this server,
# e.g. http://127.0.0.1:3000/auth/qobuz/callback. Qobuz is lenient about the host.
QOBUZ_REDIRECT_URL=

# Base URL of the proxy that serves Qobuz audio to MPD, e.g. http://localhost:8666
# The queued MPD uri becomes <proxy>/qobuz/track/version/1/trackId/<trackId>
# Needed to PLAY qobuz sources, and by the negentropy pass that swaps low-quality queued files for
# their Qobuz stream. Import, favourites and search work without it.
QOBUZ_STREAM_PROXY_SERVER=

# The session is written to .qobuz-session.json at the repo root.


###############################################################################
# YOUTUBE  (npm run cli -- youtube auth | search-track | search-playlist | import-playlist | play)
###############################################################################

# YouTube Data API v3, called directly (no SDK). Search, video, channel and playlist lookups are
# public data and need only the API key. OAuth is needed ONLY for the signed-in account's own
# liked videos and private playlists (`youtube liked`, `youtube playlists`).

# API key from a Google Cloud project with "YouTube Data API v3" enabled.
# Quota: 10,000 units/day by default. search.list costs 100 units per call; videos.list and
# playlistItems.list cost 1. Ten careless searches burn a tenth of the day, so prefer id lookups.
YOUTUBE_API_KEY=

# OAuth client from the same Google Cloud project. Google validates the redirect URI strictly:
# a private hostname such as a `.lan` name is rejected outright. Use a "Desktop app" client, which
# accepts any loopback port, or a "Web application" client on a real public https domain.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# OAuth callback, handled by GET /auth/youtube/callback on this server.
# Defaults to http://localhost:3000/auth/youtube/callback when empty.
YOUTUBE_REDIRECT_URL=

# Base URL of the Mopidy proxy that serves YouTube audio to MPD, e.g. http://localhost:8666
# The queued MPD uri becomes <proxy>/youtube?uri=yt:video:<videoId>
# Needed only to PLAY youtube sources — which includes the negentropy pass, that uses YouTube as
# the last rung of its upgrade ladder and leaves it out when this is unset. Search and playlist
# import work without it.
YOUTUBE_PROXY_AUDIO=

# The OAuth session is written to .youtube-session.json at the repo root and refreshed on a
# one-minute check. A playlist is imported as an album and the uploading channel as the artist.


###############################################################################
# SEARCH ENGINES
###############################################################################

# --- OpenSearch (the live engine) ---------------------------------------------------------
# Neural / kNN search over the `songs` index through ML Commons with a multilingual
# sentence-transformer. Used by the importers (to find an existing song before inserting),
# de-duplication, the profiler and every AI agent that searches the library.
# Set up once with `npm run cli -- opensearch create`, then `opensearch index`.
# Each key falls back to the matching ELASTIC_* value when empty. When neither is set the client
# is not created and a warning is logged.
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# --- Elasticsearch (legacy, CLI only) -------------------------------------------------------
# Entity resolution through the Zentity plugin. Reachable only from `npm run cli -- elastic ...`;
# nothing in the server or the agents uses it. Leave empty unless you still run that stack.
ELASTIC_NODE=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
# CA certificate for a self-signed cluster, as a single base64 string of the PEM file
# (e.g. `base64 -w0 ca.pem`). Empty means the system trust store.
ELASTIC_CERTIFICATE=


###############################################################################
# REDIS CACHE  (optional)
###############################################################################

# Optional. When neither REDIS_URL nor REDIS_HOST is set the cache is disabled, a warning is
# logged once and every cache call becomes a no-op. The app is fully functional without it.

# Either the full connection URL...  redis://[user:pass@]host:6379/0  (rediss:// for TLS)
REDIS_URL=

# ...or the discrete parts, assembled into that URL. Ignored entirely when REDIS_URL is set.
# Port defaults to 6379, database to 0. Username is only sent when a password is set.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
# `true` to connect over rediss:// (TLS). Only applies to the discrete form.
REDIS_TLS=

# Prefix prepended to every key so several apps can share one Redis. Defaults to dj-nounoune.
REDIS_KEY_PREFIX=
# Default expiry of cached entries in seconds. Defaults to 3600.
REDIS_TTL_SECONDS=
# Socket connect + TLS handshake timeout in milliseconds. Defaults to 2000; the app does not wait
# longer than this on a Redis that is down.
REDIS_CONNECT_TIMEOUT_MS=


###############################################################################
# PUBLIC DISPLAY  (/vibing-on)
###############################################################################

# The now-playing page served at GET /vibing-on and fed live over the /vibing Socket.io namespace.
# Its header shows a clock and the weather, and its whole palette is painted from the local sun
# cycle. Everything here is optional and degrades gracefully.

# Where the display physically is, in decimal degrees. Drives the weather and the sunrise/sunset
# the page paints its background from. Defaults to Montreal (45.5019, -73.5674) when empty.
VIBING_LATITUDE=
VIBING_LONGITUDE=

# `false` to stop fetching the weather. The header then shows the clock alone and the background
# falls back to a fixed six-to-six day. Enabled when empty. No key or account is involved: the
# upstream is Open-Meteo, called at most once every ten minutes however many viewers there are.
VIBING_WEATHER_ENABLED=

# `false` to stop the disc jockey searching the web (Gemini grounded search) for album artwork the
# importers never provided. Only that search is switched off: covers already on the album document
# still show, and so does one carried over from an earlier play of the same track. Enabled when empty.
VIBING_ALBUM_COVER_SEARCH=

# `true` to log every engine.io packet and pong on the /vibing namespace: one line per second per
# viewer. Debugging aid for dropped displays; leave empty otherwise.
VIBING_TRACE_PACKETS=


###############################################################################
# BACKGROUND JOBS
###############################################################################

# Negentropy: every 20 seconds the server scans the MPD queue ahead of the playhead, finds entries
# playing from a low-quality local file (lossy, below CD quality, or with no technical info) and
# swaps them for a streaming provider's rendition of the same recording, attaching that source to
# the song on the way. Providers are asked in quality order — Qobuz (lossless), then Spotify
# (320 kbps), then YouTube (256 kbps) — stopping at the first match, and a provider that would not
# beat the file is not asked at all: a 320 kbps mp3 only ever costs a Qobuz lookup. A provider
# whose proxy variable is unset, or that is missing from ACTIVE_SOURCE_TYPES, is left out of the
# ladder. `false` stops the scan, the lookups and the swaps; nothing else is affected. Enabled when
# empty. Never runs from the CLI; run one pass by hand with `npm run cli -- negentropy run --dry-run`.
NEGENTROPY_ENABLED=
