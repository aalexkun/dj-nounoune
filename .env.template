# Mongo Setup
MONGODB_URI=
MONGO_DATABASE=
MONGO_USER=
MONGO_PASSWORD=

# Gemini Api Key
GENAI_API_KEY=


# Server port
PORT=

## File Import
IMPORT_LIBRARY_PATH_STYLE=
# Make sure to map the last \ in the lib path.
IMPORT_LIBRARY_PATH_ROOT=
# Make sure to add the last /
LIBRARY_ROOT_PATH=

# MPD Host Info
MPD_HOST=
MPD_PORT=

# Client shared key ( to be replace by a proper jwt and oauth flow )
AUTHX_API_KEY=

# Source types the agentic client is allowed to search and play, comma separated.
# Drop a source here when its subscription lapses: the data stays in the database and the CLI,
# importers and de-duplication keep using every row, but the AI agents ignore it completely.
# Leave empty to allow every source. Values: file, spotify, applemusic, youtube, qobuz
ACTIVE_SOURCE_TYPES=file,qobuz,spotify



# Spotify App ( not in use )
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# auth/spotify/callback
SPOTIFY_REDIRECT_URL=


# Qobuz
# Can be extracted from the web player. check in the bundle code for recette, appSecret, appId keyword
QOBUZ_OAUTH_APP_ID=
QOBUZ_APP_SECRET=

# Used wireshark to capture the oauth process.
# make sure to active the SSLKEYLOGFILE in the User Env so that wireshark capture HTTPS tracfic
# look at /api.json/0.2/oauth/callback?code=yyyyyyy&private_key=xxxxxxxxx
QOBUZ_OAUTH_PRIVATE_KEY=
QOBUZ_APP_ID=
# qobuz api
QOBUZ_API_BASE=
QOBUZ_OAUTH_URL=

# Callback url auth/qobuz/callback
QOBUZ_REDIRECT_URL=


# YouTube Data API v3
# The API key is the only thing search and playback need. Create it in a Google Cloud project with
# the "YouTube Data API v3" enabled. Watch the quota: 10,000 units/day by default, and one
# search.list call costs 100 of them, while videos.list and playlistItems.list cost 1.
YOUTUBE_API_KEY=

# OAuth is ONLY needed for the signed-in account's own data ( liked videos, private playlists ).
# Create an OAuth client in the same project. Google validates the redirect uri against the client
# registration far more strictly than Qobuz does: a private hostname like the .lan one above is
# rejected outright. Use a "Desktop app" client with a loopback redirect ( any port is accepted ),
# or a "Web application" client on a real public https domain.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Callback url auth/youtube/callback. Defaults to http://localhost:3000/auth/youtube/callback
YOUTUBE_REDIRECT_URL=

# Mopidy proxy that serves the YouTube audio to MPD, e.g. http://localhost:8666
# The full queue uri becomes http://localhost:8666/youtube?uri=yt:video:VIDEOID
YOUTUBE_PROXY_AUDIO=


# Elasticsearch de-duplication and multi-source handling
ELASTIC_NODE=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_CERTIFICATE=

# opensearchThat That de-duplication and multi-source handling
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Redis cache ( optional — the app runs without it, cache calls become no-ops )
# Either set the full URL...
REDIS_URL=
# ...or the discrete parts ( ignored when REDIS_URL is set )
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=
# true to connect over rediss://
REDIS_TLS=
# Prefix prepended to every key, defaults to dj-nounoune
REDIS_KEY_PREFIX=
# Default expiry in seconds, defaults to 3600
REDIS_TTL_SECONDS=
# Socket + TLS handshake timeout in ms, defaults to 2000
REDIS_CONNECT_TIMEOUT_MS=

# true to log every engine.io packet and pong on the /vibing namespace ( one line per second per viewer )
VIBING_TRACE_PACKETS=

# false to stop the disc jockey searching the web for artwork the importers never provided.
# Only that grounded search is switched off: covers already on the album document still show, and so
# does one carried over from an earlier play of the same track. Enabled when unset.
VIBING_ALBUM_COVER_SEARCH=

# Where the display is, for the weather in the /vibing-on header and for the sun cycle the page
# paints its background from. Decimal degrees; defaults to Montreal when unset.
VIBING_LATITUDE=-33.8688
VIBING_LONGITUDE=151.2093

# false to stop fetching the weather. The header then shows the clock alone and the background falls
# back to a fixed six to six day. Enabled when unset. No key or account is involved either way:
# the upstream is Open-Meteo, called at most once every ten minutes however many viewers there are.
VIBING_WEATHER_ENABLED=

# false to stop the negentropy pass swapping queued low quality files for their Qobuz stream.
# The 20s scan, the lookups and the queue swaps all stop; nothing else is affected. Enabled when unset.
NEGENTROPY_ENABLED=
