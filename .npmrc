# Project npm policy. No credentials belong in this file; it is committed.

# Refuse to install under a Node/npm outside package.json "engines".
engine-strict=true

# Supply-chain cooling-off: never resolve a version published less than 7 days ago.
# Applies to install/update/audit fix resolution only; `npm ci` replays the lockfile untouched.
min-release-age=7

# Install-time scripts are gated by the "allowScripts" field in package.json;
# npm 11 warns on any unreviewed package. Approve with `npm approve-scripts <pkg>`.

audit=true
fund=false
